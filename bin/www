#!/usr/bin/env node

require('dotenv').config();

/**
 * Module dependencies.
 */

const https = require('https');
const fs = require('fs');

const URL = require('url');
const { app, publicApp } = require('../app');

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  const normPort = parseInt(val, 10);

  if (Number.isNaN(normPort)) {
    // named pipe
    return val;
  }

  if (normPort >= 0) {
    // port number
    return normPort;
  }

  return false;
}

/**
 * Get port from environment and store in Express.
 */

const adminPort = normalizePort(process.env.APP_PORT || '3000');
const publicPort = normalizePort(process.env.PUBLIC_PORT || '3001');

app.set('port', adminPort);
publicApp.set('port', publicPort);

/**
 * Event listener for HTTP server "error" event.
 */

function onError(port) {
  return (error) => {
    if (error.syscall !== 'listen') {
      throw error;
    }

    const bind = typeof port === 'string' ? `Pipe ${port}` : `Port ${port}`;

    // handle specific listen errors with friendly messages
    switch (error.code) {
      case 'EACCES':
        console.error(`${bind} requires elevated privileges`);
        process.exit(1);
        break;
      case 'EADDRINUSE':
        console.error(`${bind} is already in use`);
        process.exit(1);
        break;
      default:
        throw error;
    }
  };
}

/**
 * Create HTTPS servers.
 */

const myDomain = URL.parse(process.env.PUBLIC_URL);

let privateKey = '';
let certificate = '';
if (process.env.NODE_ENV === 'production') {
  privateKey = fs.readFileSync(`/etc/letsencrypt/live/${myDomain.host}/privkey.pem`);
  certificate = fs.readFileSync(`/etc/letsencrypt/live/${myDomain.host}/fullchain.pem`);
} else {
  privateKey = fs.readFileSync('./dev-certs/dev-privkey.pem');
  certificate = fs.readFileSync('./dev-certs/dev-cert.pem');
}

const tls = { key: privateKey, cert: certificate };

const serverApp = https.createServer(tls, app);
const serverPublic = https.createServer(tls, publicApp);

/**
 * Listen on provided port, on all network interfaces.
 */

serverApp.listen(adminPort, () => console.log(`API listening on :${adminPort}`));
serverApp.on('error', onError(adminPort));

serverPublic.listen(publicPort, () => console.log(`Media listening on :${publicPort}`));
serverPublic.on('error', onError(publicPort));

[Unit]
Description=ServicesServer (webserver)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/media/nuno/4C42-5F9B

[Service]
WorkingDirectory=/opt/serverrpi
ExecStart=/usr/bin/node /opt/serverrpi/bin/www
EnvironmentFile=/opt/serverrpi/.env
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
Alias=services-server.service

